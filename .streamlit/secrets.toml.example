# Example secrets file for the AI Sports Planner.
#
# Locally:    copy this to .streamlit/secrets.toml and fill in your values.
# Production: paste the contents into Streamlit Community Cloud's
#             "App settings → Secrets" editor.
#
# Every key is read by src/config.py through Settings; do NOT add anything
# extra here — unknown keys are ignored.

# --- Required ---------------------------------------------------------------

# Anthropic API key for both the Parser and Planner agents.
anthropic_api_key = "sk-ant-..."

# Fine-grained PAT scoped to the private data repo (contents: read+write).
github_token = "github_pat_..."

# Full name of the private data repo, owner/name.
github_data_repo = "your-github-username/ai-sports-data"

# Single shared password gating the Streamlit app.
app_password = "change-me"

# --- Optional (filled in during Phase 7 — Strava integration) ---------------

# strava_client_id = ""
# strava_client_secret = ""
# strava_refresh_token = ""

# --- Tunables (defaults are fine for v1) ------------------------------------

# default_branch = "main"
# llm_model = "claude-sonnet-4-6"
# agent_max_steps = 6
